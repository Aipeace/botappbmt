# Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Bybit (numbered or legacy single)
BYBIT_API_KEY_1=your_key
BYBIT_API_SECRET_1=your_secret
BYBIT_ACCOUNT_LABEL_1=Account 1

# Admin
ADMIN_ID_1=your_telegram_id

# Render (set when deploying to Render)
RENDER_EXTERNAL_URL=https://your-render-url.onrender.com
DISK_PATH=/data

# Optional: Flutterwave
FLW_SECRET_KEY=your_flw_key
FLW_SECRET_HASH=your_hash

# Optional: Paga
PAGA_PRINCIPAL=your_principal
PAGA_CREDENTIAL=your_credential
PAGA_API_KEY=your_api_key
